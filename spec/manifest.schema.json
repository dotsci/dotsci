{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dots.science/spec/manifest.schema.json",
  "title": "DotSci replication manifest",
  "description": "Pins everything a replication run depends on. Two parties running the same manifest should get the same answer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "claim_id",
    "paper",
    "datasets",
    "code",
    "environment",
    "entrypoint",
    "targets"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "0.1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": { "type": "array", "items": { "type": "string" } },
        "doi": { "type": "string" },
        "url": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string" }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest"],
      "properties": {
        "image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "seed": { "type": "integer" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "working_dir": { "type": "string" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "published", "tolerance"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "published": { "type": "number" },
          "source": {
            "type": "string",
            "description": "Where the value appears in the paper, for example 'Table 2, row 3'."
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string", "enum": ["absolute", "relative"] },
              "value": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
